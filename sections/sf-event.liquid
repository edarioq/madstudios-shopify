{%- comment -%}
  Shared private-event signup. ONE form for all 9 pages.
  Submissions are saved to Customers with tags:
    sf-event                      (everyone on this list; editable below)
    source-<page handle>          (the page they signed up on)
    resonated-<page handle>       (added by assets/sf-landing.js)
  Without JavaScript the first two tags are still saved.
{%- endcomment -%}
{%- liquid
  assign series_menu = linklists['series-pieces']
  assign base_tag = section.settings.list_tag | default: 'sf-event' | handleize
  assign source_tag = 'source-' | append: page.handle
  assign is_series_page = false
  if template.suffix == 'sf-series'
    assign is_series_page = true
  endif
-%}
<section class="sf-event" id="sf-event" aria-labelledby="sf-event-title">
  <div class="sf-wrap sf-event__inner">
    <div class="sf-event__copy">
      {%- if section.settings.pill != blank -%}
        <span class="sf-pill">{{ section.settings.pill | escape }}</span>
      {%- endif -%}
      <h2 class="sf-event__title" id="sf-event-title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="sf-event__text">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="sf-facts">
        {%- if section.settings.fact_1 != blank -%}<span>{{ section.settings.fact_1 | escape }}</span>{%- endif -%}
        {%- if section.settings.fact_2 != blank -%}<span>{{ section.settings.fact_2 | escape }}</span>{%- endif -%}
        {%- if section.settings.fact_3 != blank -%}<span>{{ section.settings.fact_3 | escape }}</span>{%- endif -%}
      </div>
    </div>

    {%- form 'customer', id: 'sf-signup', class: 'sf-form' -%}
      {%- if form.posted_successfully? -%}
        <div class="sf-thanks" tabindex="-1" data-sf-thanks>
          <h3 class="sf-thanks__title">{{ section.settings.thanks_heading | escape }}</h3>
          <p>{{ section.settings.thanks_text | escape }}</p>
          <a class="sf-btn sf-btn--dark" href="#sf-series-grid">{{ section.settings.thanks_button | escape }}</a>
        </div>
      {%- else -%}
        {%- if form.errors -%}
          <div class="sf-form__errors" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <input type="hidden" name="contact[tags]" value="{{ base_tag }}, {{ source_tag }}" data-sf-tags data-sf-base="{{ base_tag }}, {{ source_tag }}">

        <div class="sf-row2">
          <div class="sf-field">
            <label for="sf-first">First name</label>
            <input id="sf-first" type="text" name="contact[first_name]" autocomplete="given-name" placeholder="First">
          </div>
          <div class="sf-field">
            <label for="sf-last">Last name</label>
            <input id="sf-last" type="text" name="contact[last_name]" autocomplete="family-name" placeholder="Last">
          </div>
        </div>

        <div class="sf-field">
          <label for="sf-email">Email <span>(required)</span></label>
          <input id="sf-email" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="you@email.com" required aria-describedby="sf-email-error">
          <span class="sf-error" id="sf-email-error" aria-live="polite"></span>
        </div>

        <div class="sf-field">
            <label for="sf-fav">Which piece resonated with you?</label>
            <select id="sf-fav" data-sf-fav>
              {%- if is_series_page -%}
                {%- for link in series_menu.links -%}
                  {%- if link.type == 'page_link' -%}
                    <option value="{{ link.object.handle }}">{{ link.object.title | escape }}</option>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                <option value="{{ page.handle }}">{{ page.title | escape }} (this piece)</option>
                <option value="another">Another piece in the series</option>
              {%- endif -%}
              <option value="discovering">Just discovering MAD Studios</option>
            </select>
        </div>

        <div>
          <div class="sf-consent">
            <input id="sf-consent" type="checkbox" required aria-describedby="sf-consent-error">
            <label for="sf-consent">
              {{ section.settings.consent_text | escape }}
              {%- if shop.privacy_policy %} See our <a href="{{ shop.privacy_policy.url }}">Privacy Policy</a>.{% endif -%}
            </label>
          </div>
          <span class="sf-error" id="sf-consent-error" aria-live="polite"></span>
        </div>

        <button type="submit" class="sf-btn sf-btn--dark">{{ section.settings.button_text | escape }}</button>
        {%- if section.settings.fine_print != blank -%}
          <p class="sf-fine">{{ section.settings.fine_print | escape }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Private event signup",
  "settings": [
    {
      "type": "text",
      "id": "pill",
      "label": "Label",
      "default": "Private event · First access"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Be first in the room."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>An intimate live session: Melissa creates a new work in real time while the music plays live in the room. People on this list hear the date and get access before tickets open to the public.</p>"
    },
    {
      "type": "text",
      "id": "fact_1",
      "label": "Detail 1",
      "default": "[Date TBA]"
    },
    {
      "type": "text",
      "id": "fact_2",
      "label": "Detail 2",
      "default": "[Venue], Miami"
    },
    {
      "type": "text",
      "id": "fact_3",
      "label": "Detail 3",
      "default": "[Seat count — confirm]"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "textarea",
      "id": "consent_text",
      "label": "Consent checkbox text",
      "default": "Yes, email me the private event details and MAD Studios news. Unsubscribe anytime."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Get first access"
    },
    {
      "type": "textarea",
      "id": "fine_print",
      "label": "Fine print",
      "default": "Joining the list does not reserve or purchase a ticket. Date, details and pricing will be emailed first to this list."
    },
    {
      "type": "text",
      "id": "list_tag",
      "label": "List tag",
      "default": "sf-event",
      "info": "Added to every signup. Change it only for a new event, so reports stay separate."
    },
    {
      "type": "header",
      "content": "After signup"
    },
    {
      "type": "text",
      "id": "thanks_heading",
      "label": "Heading",
      "default": "You're on the list."
    },
    {
      "type": "textarea",
      "id": "thanks_text",
      "label": "Text",
      "default": "We'll email the date and private access before tickets open to the public. Joining the list does not reserve a ticket."
    },
    {
      "type": "text",
      "id": "thanks_button",
      "label": "Button text",
      "default": "See the series"
    }
  ]
}
{% endschema %}
